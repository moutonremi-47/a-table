{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fichier d'import de recettes — À table",
  "type": "object",
  "required": ["format", "version", "recettes"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "a-table-recettes" },
    "version": { "const": 1 },
    "recettes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/recette" } }
  },
  "additionalProperties": false,
  "$defs": {
    "recette": {
      "type": "object",
      "required": ["id", "nom", "photo", "portions", "categories", "ingredients", "etapes", "nutrition_par_portion"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Identifiant unique, minuscules et tirets" },
        "nom": { "type": "string", "minLength": 1 },
        "photo": { "type": "string", "minLength": 1, "description": "Chemin relatif (photos/xxx.jpg), URL https ou data:image/...;base64" },
        "emoji": { "type": "string", "maxLength": 8, "description": "Pictogramme affiché dans le semainier (facultatif)" },
        "source": { "type": "string", "description": "Lien de la publication d'origine (Instagram, Facebook...)" },
        "portions": { "type": "integer", "minimum": 1 },
        "preparation_min": { "type": "integer", "minimum": 0 },
        "cuisson_min": { "type": "integer", "minimum": 0 },
        "categories": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["viande", "poisson", "vege", "soupe", "rapide", "gouter"] }
        },
        "repas": {
          "type": "array", "uniqueItems": true,
          "items": { "enum": ["midi", "gouter", "diner"] }
        },
        "saison": {
          "type": "array", "uniqueItems": true,
          "items": { "enum": ["jan", "fev", "mar", "avr", "mai", "jun", "jul", "aou", "sep", "oct", "nov", "dec"] }
        },
        "favori": { "type": "boolean" },
        "ingredients": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["nom", "quantite", "unite"],
            "additionalProperties": false,
            "properties": {
              "nom": { "type": "string", "minLength": 1 },
              "quantite": { "type": "number", "exclusiveMinimum": 0, "description": "Quantité pour le nombre de portions de la recette" },
              "unite": { "enum": ["g", "kg", "ml", "cl", "l", "pc", "c.à.s", "c.à.c", "pincée"] },
              "rayon": { "type": "string" }
            }
          }
        },
        "etapes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "nutrition_par_portion": {
          "type": "object",
          "required": ["kcal", "proteines_g", "sucres_g", "fibres_g"],
          "additionalProperties": false,
          "properties": {
            "kcal": { "type": "number", "minimum": 0 },
            "proteines_g": { "type": "number", "minimum": 0 },
            "glucides_g": { "type": "number", "minimum": 0 },
            "sucres_g": { "type": "number", "minimum": 0 },
            "lipides_g": { "type": "number", "minimum": 0 },
            "fibres_g": { "type": "number", "minimum": 0 },
            "sel_g": { "type": "number", "minimum": 0 }
          }
        }
      }
    }
  }
}
